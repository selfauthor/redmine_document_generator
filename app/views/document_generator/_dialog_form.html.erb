<h3 class="title"><%= l('document_generator.dialog_title') %></h3>
<%# Показываем ошибку, если JSON-снимок отсутствует или недействителен. %>
<% if @snapshot_error.present? %>
  <p class="error" role="alert"><%= @snapshot_error %></p>
<% end %>

<%= form_tag document_generator_export_path(@project),
             method: :post,
             id: 'document-generator-form',
             multipart: true,
             data: {
               progress_title: l('document_generator.progress_title'),
               progress_preparing: l('document_generator.progress_preparing'),
               progress_rendering: l('document_generator.progress_rendering'),
               progress_wait: l('document_generator.progress_wait'),
               progress_stage_preparing: l('document_generator.progress_stage_preparing'),
               progress_stage_rendering: l('document_generator.progress_stage_rendering'),
               progress_error: l('document_generator.error_progress_request_failed')
             } do %>

  <fieldset class="box">
    <legend><%= l('document_generator.export_parameters') %></legend>

    <p class="dg-form-row">
      <label class="dg-form-label" for="template_file"><%= l('document_generator.template_file') %></label>
      <span class="dg-form-control">
        <%= file_field_tag 'template_file',
                           accept: '.docx,.xlsx',
                           required: true,
                           id: 'template_file' %>
        <span id="dg-template-error" class="error" style="display:none;">
          <%= l('document_generator.error_invalid_format') %>
        </span>
      </span>
    </p>

    <p class="dg-form-row">
      <label class="dg-form-label"><%= l('document_generator.export_mode') %></label>
      <span class="dg-form-control">
        <label class="block">
          <%= radio_button_tag 'export_mode', 'single', true %>
          <%= l('document_generator.export_mode_single') %>
        </label>

        <label class="block">
          <%= radio_button_tag 'export_mode', 'combined' %>
          <%= l('document_generator.export_mode_combined') %>
        </label>
      </span>
    </p>

    <p class="dg-form-row">
      <label class="dg-form-label" for="dg_file_name"><%= l('document_generator.file_name') %></label>
      <span class="dg-form-control">
        <%= text_field_tag 'file_name',
                           l('document_generator.default_file_name', default: 'Export'),
                           required: true,
                           id: 'dg_file_name' %>
        <span id="dg-filename-error" class="error" style="display:none;">
          <%= l('document_generator.error_invalid_filename') %>
        </span>
      </span>
    </p>
  </fieldset>

  <fieldset class="box">
    <legend><%= l('document_generator.settings') %></legend>

    <p class="dg-form-row">
      <label class="dg-form-label"><%= l('document_generator.description_format') %></label>
      <span class="dg-form-control">
        <label class="block">
          <%= radio_button_tag 'description_format', 'raw', true, id: 'dg-description-format-raw' %>
          <%= l('document_generator.description_format_raw') %>
        </label>

        <label class="block" id="dg-description-format-redmine-label">
          <%= radio_button_tag 'description_format',
                               'redmine',
                               false,
                               id: 'dg-description-format-redmine' %>
          <%= l('document_generator.description_format_redmine') %>
        </label>

        <span id="dg-description-format-disabled"
              class="description"
              style="display:none;">
          <%= l('document_generator.description_format_word_only') %>
        </span>
      </span>
    </p>

    <p class="dg-form-row">
      <label class="dg-form-label" for="error_behavior"><%= l('document_generator.error_behavior') %></label>
      <span class="dg-form-control">
        <%= select_tag 'error_behavior',
                       options_for_select([
                         [l('document_generator.error_abort'), 'abort'],
                         [l('document_generator.error_skip_field'), 'skip_field'],
                         [l('document_generator.error_skip_record'), 'skip_record']
                       ]),
                       id: 'error_behavior' %>
      </span>
    </p>
  </fieldset>

  <fieldset class="box">
    <legend><%= l(:label_document_generator_information) %></legend>

    <p id="dg-records-count"
       data-count="<%= @record_count %>">
      <%= l('document_generator.records_count', count: @record_count) %>
    </p>

    <p id="dg-files-count"
       data-text-single="<%= l('document_generator.single_file') %>"
       data-text-multiple="<%= l('document_generator.files_count', count: @record_count) %>">
      <%= @record_count > 1 ?
           l('document_generator.files_count', count: @record_count) :
           l('document_generator.single_file') %>
    </p>

  </fieldset>

  <fieldset class="box">
    <legend><%= l('document_generator.available_files') %></legend>

    <% if @available_files.present? %>
      <table class="list">
        <thead>
          <tr>
            <th><%= l('document_generator.available_file_name') %></th>
            <th><%= l('document_generator.available_file_created_at') %></th>
            <th><%= l('document_generator.available_file_user') %></th>
          </tr>
        </thead>
        <tbody>
          <% @available_files.each do |file| %>
            <tr>
              <td>
                <%= link_to file[:filename], file[:url] %>
              </td>
              <td>
                <%= format_time(file[:created_at]) %>
              </td>
              <td>
                <%= link_to_user(file[:user]) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="nodata">
        <%= l('document_generator.no_available_files') %>
      </p>
    <% end %>
  </fieldset>

  <p class="buttons">

    <%= submit_tag l('document_generator.button_export'),
                   id: 'dg-submit-btn',
                   disabled: true,
                   data: { disable_with: l('document_generator.button_export') } %>

    <%= link_to l('button_cancel'), '#',
                onclick: "hideModal(this); return false;" %>

    <span id="dg-download-link-container"
          class="dg-download-link-container"
          style="display:none;">
      <span id="dg-download-link-message">
        <%= l('document_generator.download_fallback_text') %>
      </span>
      <a id="dg-download-link"
         href="#"
         target="_blank"
         rel="noopener">
        <%= l('document_generator.download_link_text') %>
      </a>
    </span>
  </p>

  <%# Передаём UUID снимка, созданного при отображении списка задач. %>
  <%= hidden_field_tag 'issue_list_token', @issue_list_token %>

<% end %>
